pkgname=dwlmsg-accme
_commit=7be655ef47c80136c4a4132767423c1db5085d02
pkgver=0.r0.g7be655e
pkgrel=1
pkgdesc="CLI client for dwl's IPC protocol, patched for dwl-accme's ipc.patch"
arch=(x86_64)
url="https://codeberg.org/notchoc/dwlmsg"
license=(0BSD)
depends=(wayland)
makedepends=(git)
provides=(dwlmsg)
conflicts=(dwlmsg)
source=("git+https://codeberg.org/notchoc/dwlmsg.git#commit=$_commit"
        dwl-ipc.patch)
sha256sums=(SKIP SKIP)

prepare() {
  cd dwlmsg
  patch -Np1 -i "$srcdir/dwl-ipc.patch"
}

build() {
  cd dwlmsg
  make
}

package() {
  cd dwlmsg
  make PREFIX="$pkgdir/usr" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
